# Copy to an external local configuration file; supply secrets through environment variables.
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/massac}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.repositories.enabled=false
security.jwt.secret=${JWT_SECRET}
security.jwt.issuer=massac
security.jwt.access-ttl=15m
security.jwt.refresh-ttl=7d
security.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000}
spring.batch.job.enabled=false
